# Khotan environment template
# Copy values into .env.local or your deployment environment.

# Postgres connection string used by Drizzle and khotan.
DATABASE_URL=postgres://user:password@localhost:5432/app

# AES-256-GCM key for encrypted plug vars. Generate with: openssl rand -hex 32
KHOTAN_SECRET=

# Enables khotan debug routes and CLI plug debugging in development only.
KHOTAN_DEBUG=1

# Public base URL for webhook callbacks during local development.
KHOTAN_WEBHOOK_URL=https://example.ngrok.app

# Bearer token for /api/khotan/cron in production. Generate with: openssl rand -hex 32
CRON_SECRET=
